# ================================
# AgriVibe Root Git Ignore
# ================================

# Dependencies
node_modules/

# Environment variables / secrets
.env
.env.*
!.env.example

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Temporary files
*.tmp
*.temp

# Test / coverage output
coverage/

# Local development database
backend/data/db.json